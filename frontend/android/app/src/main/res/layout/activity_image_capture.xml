<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Geometry and colors come from Flutter AppHeader through the channel. -->
    <RelativeLayout
        android:id="@+id/capture_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <FrameLayout
            android:id="@+id/capture_header_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/iv_brand_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="matrix"
                android:contentDescription="Misbar" />

            <TextView
                android:id="@+id/tv_brand_logo_fallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Misbar"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>

    </RelativeLayout>

    <!-- Main Scanner Dark Green View -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E3526">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_scan_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="Scan Packed Label"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Viewfinder Center Container -->
        <LinearLayout
            android:id="@+id/layout_viewfinder_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/viewfinder_box"
                android:layout_width="260dp"
                android:layout_height="200dp">

                <!-- Corners Frame -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/viewfinder_corners"
                    android:scaleType="fitXY" />

                <!-- Center Price Tag -->
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_tag" />

                <!-- Scanning Laser Line -->
                <View
                    android:id="@+id/view_laser_line"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/laser_line_glow" />

            </RelativeLayout>

            <!-- Helper Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="40dp"
                android:text="Waiting for the label — position it in the frame, then tap Take Photo"
                android:textAlignment="center"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Bottom Controls Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="36dp"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Same primary camera action as the Dish Scan screen. -->
            <LinearLayout
                android:id="@+id/btn_capture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Take Photo"
                android:gravity="center"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_shutter_outer">

                    <ImageView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_camera" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Take Photo"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Same secondary gallery action as the Dish Scan screen. -->
            <LinearLayout
                android:id="@+id/btn_upload_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Upload Image"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:src="@drawable/ic_gallery"
                    android:padding="15.5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Upload Image"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
