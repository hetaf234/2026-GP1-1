# INACTIVE PREPARATION TEMPLATE. Owner approval is required before renaming to .yml.
name: Misbar CI
'on':
  pull_request:
    branches:
    - main
  push:
    branches:
    - main
permissions:
  contents: read
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true
jobs:
  changes:
    runs-on: ubuntu-24.04
    outputs:
      backend: ${{ steps.paths.outputs.backend }}
      frontend: ${{ steps.paths.outputs.frontend }}
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        persist-credentials: false
        fetch-depth: 0
    - name: Scan publication candidates
      run: python3 deployment/secret_scan.py
    - id: paths
      run: python3 deployment/changed_paths.py
  backend:
    name: Backend unit and security checks
    needs: changes
    if: needs.changes.outputs.backend == 'true'
    runs-on: ubuntu-24.04
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        persist-credentials: false
    - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0
      with:
        python-version: '3.14'
    - uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad
      with:
        distribution: temurin
        java-version: '21'
    - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
      with:
        node-version: '24'
    - name: Install pinned dependencies
      run: python -m pip install --extra-index-url https://download.pytorch.org/whl/cpu -r deployment/test-requirements.txt
        -c deployment/requirements.lock.txt
    - name: Run mocked unit and deployment contracts
      run: python deployment/run_checks.py --backend
    - name: Install pinned emulator CLI
      run: npm ci --prefix deployment/tools --ignore-scripts --no-audit --no-fund
    - name: Firestore local demo security tests
      run: deployment/tools/node_modules/.bin/firebase emulators:exec --only firestore --project demo-misbar-metadata
        'python -m unittest discover -s security_tests -p "*_test.py"'
  flutter:
    name: Flutter checks
    needs: changes
    if: needs.changes.outputs.frontend == 'true'
    runs-on: ubuntu-24.04
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        persist-credentials: false
    - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0
      with:
        python-version: '3.14'
    - uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad
      with:
        distribution: temurin
        java-version: '21'
    - name: Install the approved Flutter commit
      run: bash deployment/install_flutter.sh
    - name: Resolve locked Flutter dependencies
      run: flutter pub get
      working-directory: frontend
    - name: Check formatting
      run: dart format --output=none --set-exit-if-changed lib test
      working-directory: frontend
    - name: Analyze Flutter
      run: flutter analyze --no-pub
      working-directory: frontend
    - name: Run mock widget and unit tests
      run: flutter test --no-pub
      working-directory: frontend
    - name: Build Android compatibility APK
      run: flutter build apk --debug --no-pub --flavor misbar2 --dart-define=MISBAR_SECOND_COPY=true --dart-define=MISBAR_API_BASE_URL=http://127.0.0.1:8080
      working-directory: frontend
  result:
    name: Misbar CI
    if: always()
    needs:
    - changes
    - backend
    - flutter
    runs-on: ubuntu-24.04
    steps:
    - name: Require success or a deliberate path skip
      run: 'python3 - <<''PY''

        import os

        assert os.environ[''CHANGES''] == ''success''

        assert all(os.environ[x] in [''success'',''skipped''] for x in [''BACKEND'',''FLUTTER''])

        PY'
      env:
        CHANGES: ${{ needs.changes.result }}
        BACKEND: ${{ needs.backend.result }}
        FLUTTER: ${{ needs.flutter.result }}
